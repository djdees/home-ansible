# /etc/otelcol-contrib/config.yaml
# Managed by Ansible (otel_collector role)

receivers:
  otlp:
    protocols:
      grpc:
        endpoint: 0.0.0.0:4317
      http:
        endpoint: 0.0.0.0:4318

{% if otel_collect_host_metrics %}
  hostmetrics:
    collection_interval: {{ otel_metrics_interval }}
    scrapers:
      cpu:
      disk:
      filesystem:
        exclude_mount_points:
          mount_points: [/dev, /proc, /sys, /run]
          match_type: strict
      load:
      memory:
      network:
      paging:
      processes:
{% endif %}
{% if otel_collect_docker_stats %}
  docker_stats:
    endpoint: unix:///var/run/docker.sock
    collection_interval: {{ otel_metrics_interval }}
    timeout: 10s
{% endif %}

processors:
  batch:
    timeout: 5s
    send_batch_size: 1000

  # Detects host info (hostname, OS) and adds as resource attributes
  resourcedetection:
    detectors: [system]
    system:
      hostname_sources: [os]
    timeout: 5s

  # Stamp every signal with a consistent service.name and host.name
  resource:
    attributes:
      - key: service.name
        value: "{{ otel_service_name }}"
        action: upsert
      - key: host.name
        value: "{{ inventory_hostname }}.{{ home_domain }}"
        action: upsert

exporters:
  prometheusremotewrite/victoriametrics:
    endpoint: "http://ratatosk.home.arpa:8428/api/v1/write"

service:
  pipelines:
    metrics:
      receivers: [hostmetrics, otlp, docker_stats]
      processors: [batch, resourcedetection, resource]
      exporters: [prometheusremotewrite/victoriametrics]
